<?xml version="1.0" ?>
<!-- The entity manager and configuration classes are swapped for their logging-enabled
 subclasses by Debesha\DoctrineProfileExtraBundle\DependencyInjection\Compiler\OverrideOrmClassesPass -->

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="debesha.doctrine_extra_profiler.data_collector"
                 class="Debesha\DoctrineProfileExtraBundle\DataCollector\HydrationDataCollector" public="false">
            <argument type="service" id="doctrine"/>
            <tag name="data_collector" template="@DebeshaDoctrineProfileExtra/Collector/hydrations.html.twig"
                 id="hydrations"/>
        </service>
    </services>
</container>
